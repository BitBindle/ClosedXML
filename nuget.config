<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear/>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
		<!-- The fork of ClosedXML.Parser is on GitHub Packages. The feed needs authentication, also for a public package. -->
		<add key="github-bitbindle" value="https://nuget.pkg.github.com/BitBindle/index.json" protocolVersion="3" />
	</packageSources>
	<!-- The user name and a token with the read:packages scope come from environment variables. CI uses GITHUB_TOKEN. -->
	<packageSourceCredentials>
		<github-bitbindle>
			<add key="Username" value="%GITHUB_PACKAGES_USER%" />
			<add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
		</github-bitbindle>
	</packageSourceCredentials>
	<!-- nuget.org has a package with the same ID. The mapping makes sure that NuGet gets ClosedXML.Parser only from the fork feed. -->
	<packageSourceMapping>
		<packageSource key="github-bitbindle">
			<package pattern="ClosedXML.Parser" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
