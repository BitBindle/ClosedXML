root = true

[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# Bash does not run a script with CRLF line endings.
[*.sh]
end_of_line = lf

# 4 space indentation
[*.cs]
charset=utf-8
indent_style = space
indent_size = 4

# CA1820: Test for empty strings using string length
dotnet_diagnostic.CA1820.severity = error
